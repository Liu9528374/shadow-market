    {
      "sentenceId": "s_0002",
      "start": 1.6,
      "end": 3,
      "text": "Sure. Would you like it hot or iced?",
      "translation": "好的，你要热的还是冰的？",
      "notes": ""
    },
    {
      "sentenceId": "s_0003",
      "start": 3.2,
      "end": 4.8,
      "text": "Iced, please. And a blueberry muffin.",
      "translation": "冰的，谢谢。再来一个蓝莓松饼。",
