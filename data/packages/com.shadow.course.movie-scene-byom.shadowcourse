  "sentences": [
    {
      "sentenceId": "s_0001",
      "start": 0,
      "end": 2.2,
      "text": "Hey, are you free this weekend?",
      "translation": "嘿，你这周末有空吗？",
      "notes": "句尾升调；are you 连读成 are-you。"
    },
    {
      "sentenceId": "s_0002",
      "start": 2.8,
      "end": 5.4,
      "text": "I think so. What did you have in mind?",
      "translation": "应该有空。你有什么想法？",
      "notes": "What did you 口语常说 whad-ya；in mind 连读。"
    },
    {
      "sentenceId": "s_0003",
      "start": 6,
      "end": 9.2,
      "text": "There's a new market downtown. Want to check it out?",
      "translation": "市中心新开了一个市集。想去看看吗？",
      "notes": "There's a 连读成 there-za；check it out 连读成 che-ki-tout。"
    },
    {
      "sentenceId": "s_0004",
      "start": 9.8,
      "end": 12,
      "text": "Sounds fun. Let's meet at noon.",
      "translation": "听起来不错。中午见吧。",
      "notes": "Sounds fun 的 ds 轻读；meet at 连读成 mee-tat。"
    },
    {
      "sentenceId": "s_0005",
      "start": 12.6,
      "end": 15,
      "text": "Perfect. See you by the entrance.",
      "translation": "好极了。入口见。",
      "notes": "See you 连读成 see-ya；by the 弱读。"
    }
  ],
