  "sentences": [
    {
      "sentenceId": "s_0001",
      "start": 0.104,
      "end": 3.667,
      "text": "Hi, could I get a medium oat milk latte, please?",
      "translation": "你好，我要一杯中杯燕麦拿铁。",
      "notes": "重音：get · medium · oat · latte\n连读：could I → coul-dai\n提示：Could I get 连读成 coul-dai-get，语气上扬更礼貌。"
    },
    {
      "sentenceId": "s_0002",
      "start": 4.429,
      "end": 8.033,
      "text": "Sure. Would you like it hot or iced?",
      "translation": "好的。你要热的还是冰的？",
      "notes": "重音：hot · iced\n连读：would you → woul-joo\n提示：hot or iced 三个词要连起来读，重音落在 hot 和 iced。"
    },
    {
      "sentenceId": "s_0003",
      "start": 8.791,
      "end": 13.02,
      "text": "Iced, please. And can I get an extra shot?",
      "translation": "冰的，谢谢。可以再加一份浓缩吗？",
      "notes": "重音：Iced · extra · shot\n连读：get an → ge-da\n提示：extra 的重音在第一音节：EK-stra。"
    },
    {
      "sentenceId": "s_0004",
      "start": 13.777,
      "end": 17.245,
      "text": "Of course. That'll be four fifty.",
      "translation": "当然。一共四块五。",
      "notes": "重音：four · fifty\n连读：That'll → tha-dl\n提示：That'll be 缩读成 tha-dl-be，不要逐字念。"
    },
    {
      "sentenceId": "s_0005",
      "start": 18.016,
      "end": 21.634,
      "text": "Great, thanks. Can I pay by card?",
      "translation": "好的，谢谢。可以刷卡吗？",
      "notes": "重音：pay · card\n连读：pay by → pay-bai\n提示：pay by 连读，card 的 r 要卷舌但别太重。"
    }
  ],
